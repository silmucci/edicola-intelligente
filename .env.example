GEMINI_API_KEY=your_api_key_here
GEMINI_RAG_MODEL=gemini-3.5-flash-lite
GEMINI_RAG_TOP_K=3
MAP_ADJACENT_CHUNKS=2
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Kore

# Solo sviluppo: diagnostica Archivio nascosta nella presentazione cliente.
EDICOLA_ARCHIVE_DIAGNOSTICS=0

# Default sicuro: account OIDC/PostgreSQL. Credenziali solo in Streamlit Secrets.
EDICOLA_PROFILE_MODE=accounts
# Per la sola demo di sviluppo Windows: impostare esplicitamente local_demo
# nell'ambiente della shell prima dell'avvio; non abilitarlo nel cloud.
